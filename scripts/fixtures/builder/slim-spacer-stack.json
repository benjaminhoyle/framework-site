{
  "id": "slim-spacer-stack",
  "output_name": "slim-spacer-stack",
  "description": "slim spacer behaves like a same-depth extension",
  "modules": [
    {
      "id": "base",
      "type": "slim_base_trimmed",
      "x": 0,
      "y": 0,
      "placement": "floor"
    },
    {
      "id": "spacer",
      "type": "slim_spacer",
      "x": 0,
      "y": 0,
      "on": "base"
    },
    {
      "id": "extension",
      "type": "slim_extension_trimmed",
      "x": 0,
      "y": 0,
      "on": "spacer"
    }
  ]
}
