{
  "id": "compact-spacer-stack",
  "output_name": "compact-spacer-stack",
  "description": "compact spacer behaves like a same-depth extension",
  "modules": [
    {
      "id": "base",
      "type": "compact_base_trimmed",
      "x": 0,
      "y": 0,
      "placement": "floor"
    },
    {
      "id": "spacer",
      "type": "compact_spacer",
      "x": 0,
      "y": 0,
      "on": "base"
    },
    {
      "id": "extension",
      "type": "compact_extension_trimmed",
      "x": 0,
      "y": 0,
      "on": "spacer"
    }
  ]
}
