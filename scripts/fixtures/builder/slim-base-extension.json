{
  "id": "slim-base-extension",
  "output_name": "slim-base-extension",
  "description": "slim base with matching extension",
  "modules": [
    {
      "id": "base",
      "type": "slim_base_trimmed",
      "x": 0,
      "y": 0,
      "placement": "floor"
    },
    {
      "id": "extension",
      "type": "slim_extension_trimmed",
      "x": 0,
      "y": 0,
      "on": "base"
    }
  ]
}
