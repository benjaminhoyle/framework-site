{
  "id": "wide-spacer-stack",
  "output_name": "wide-spacer-stack",
  "description": "wide spacer behaves like a same-depth extension",
  "modules": [
    {
      "id": "base",
      "type": "wide_base_trimmed",
      "x": 0,
      "y": 0,
      "placement": "floor"
    },
    {
      "id": "spacer",
      "type": "wide_spacer",
      "x": 0,
      "y": 0,
      "on": "base"
    },
    {
      "id": "extension",
      "type": "wide_extension_trimmed",
      "x": 0,
      "y": 0,
      "on": "spacer"
    }
  ]
}
