{
  "id": "standard-spacer-stack",
  "output_name": "standard-spacer-stack",
  "description": "standard spacer behaves like a same-depth extension",
  "modules": [
    {
      "id": "base",
      "type": "standard_base_trimmed",
      "x": 0,
      "y": 0,
      "placement": "floor"
    },
    {
      "id": "spacer",
      "type": "standard_spacer",
      "x": 0,
      "y": 0,
      "on": "base"
    },
    {
      "id": "extension",
      "type": "standard_extension_trimmed",
      "x": 0,
      "y": 0,
      "on": "spacer"
    }
  ]
}
