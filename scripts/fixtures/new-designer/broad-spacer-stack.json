{
  "id": "broad-spacer-stack",
  "output_name": "broad-spacer-stack",
  "description": "broad spacer behaves like a same-depth extension",
  "modules": [
    {
      "id": "base",
      "type": "broad_base_trimmed",
      "x": 0,
      "y": 0,
      "placement": "floor"
    },
    {
      "id": "spacer",
      "type": "broad_spacer",
      "x": 0,
      "y": 0,
      "on": "base"
    },
    {
      "id": "extension",
      "type": "broad_extension_trimmed",
      "x": 0,
      "y": 0,
      "on": "spacer"
    }
  ]
}
