{
  "id": "wide-adapter-split-bridge",
  "output_name": "wide-adapter-split-bridge",
  "description": "wide adapter split into standard booster plus slim extension, then bridged by a wide extension",
  "modules": [
    {
      "id": "base",
      "type": "wide_base_trimmed",
      "x": 0,
      "y": 0,
      "placement": "floor"
    },
    {
      "id": "adapter",
      "type": "wide_adapter_trimmed",
      "x": 0,
      "y": 0,
      "on": "base"
    },
    {
      "id": "booster",
      "type": "standard_booster",
      "x": 0,
      "y": 0,
      "on": "adapter"
    },
    {
      "id": "slim_extension",
      "type": "slim_extension_trimmed",
      "x": 703,
      "y": 0,
      "on": "adapter"
    },
    {
      "id": "wide_bridge",
      "type": "wide_extension_trimmed",
      "x": 0,
      "y": 0,
      "on": [
        "booster",
        "slim_extension"
      ]
    }
  ]
}
